#!/bin/sh
set -eu
: "${TRIM_APPDEST:?}" "${TRIM_PKGVAR:?}" "${TRIM_PKGETC:?}"
TRIM_APPDEST=$(cd "$TRIM_APPDEST" && pwd -P)
pidfile="$TRIM_PKGVAR/server.pid"
export PATH="$TRIM_APPDEST:$PATH"
export HOME="$TRIM_PKGVAR"
export XBM_GATEWAY_SOCKET="$TRIM_APPDEST/app.sock"
# Only signal our own process; a stale PID may have been reused.
alive() {
    [ -f "$pidfile" ] || return 1
    pid=$(cat "$pidfile")
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    [ "$(readlink "/proc/$pid/exe")" = "$TRIM_APPDEST/server/xbm" ]
}
case "${1:-}" in
 start)
    if alive; then
        "$TRIM_APPDEST/server/xbm" --check-service http://127.0.0.1:8765 "$TRIM_PKGETC/config.toml" >> "$TRIM_PKGVAR/server.log" 2>&1
        exit $?
    fi
    mkdir -p "$TRIM_PKGVAR" "$TRIM_PKGETC"
    "$TRIM_APPDEST/server/xbm" --config "$TRIM_PKGETC/config.toml" serve --port 8765 >> "$TRIM_PKGVAR/server.log" 2>&1 &
    echo $! > "$pidfile"
    # Fail visibly if the port is occupied or initialization fails.
    sleep 2
    if ! alive; then
        tail -n 15 "$TRIM_PKGVAR/server.log" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
        rm -f "$pidfile"
        exit 1
    fi
    if ! "$TRIM_APPDEST/server/xbm" --check-service http://127.0.0.1:8765 "$TRIM_PKGETC/config.toml" >> "$TRIM_PKGVAR/server.log" 2>&1; then
        if alive; then kill "$pid"; fi
        echo "服务启动验证失败，请检查日志中的版本和存储配置。" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
        exit 1
    fi ;;
 stop)
    if alive; then
        kill "$pid"
        for n in $(seq 1 30); do
            alive || break
            sleep 1
        done
        if alive; then echo "服务未退出，请检查日志。" >&2; exit 1; fi
    fi
    rm -f "$pidfile" ;;
 status) alive || exit 3 ;;
 restart) "$0" stop; "$0" start ;;
 *) exit 1 ;;
esac
