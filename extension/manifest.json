{
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Bookmark Sync"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "injected.js"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "description": "被动拦截 X 书签数据并推送到 NAS 服务端（xbm）",
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "manifest_version": 3,
  "name": "X Bookmark Sync",
  "options_page": "options.html",
  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],
  "version": "0.2.5",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
